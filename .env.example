# Application
APP_NAME=one-backend
APP_ENV=development
APP_PORT=3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=one_erp
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINUTES=30

# JWT Authentication
JWT_SECRET=supersecret-jwt-key-one-erp-2026-change-in-production
JWT_EXPIRES_IN=24h

# Cloudflare R2 (S3-compatible object storage) — leave blank to disable, falls back to metadata-only storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
# Used when R2 is blank: keep uploaded files (HR and CRM documents, Drive) on local disk under this folder
LOCAL_STORAGE_DIR=

# OpenAI (meeting transcription + AI summaries) — leave blank to disable, falls back to templated notes
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# WhatsApp Cloud API (Meta) - onboarding invite links
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v20.0

# SMTP - onboarding invite emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ONE ERP

# Frontend base URL
FRONTEND_BASE_URL=http://localhost:3001

# Internal, service-to-service auth for the standalone abc-backend
# (Associate Business Consultant program) calling this backend's
# /internal/provisioning endpoints to create companies/tenants.
INTERNAL_PROVISIONING_TOKEN=
